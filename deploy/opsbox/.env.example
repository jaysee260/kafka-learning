# Copy to .env (which is gitignored) and edit.

# The address other machines use to reach this host: its LAN IP, or a
# hostname that every client can resolve. The broker hands this address to
# every client that connects on port 19092, so it must be reachable from
# wherever your producers and consumers run. Give the host a static IP or a
# DHCP reservation, or clients break when the address changes.
REDPANDA_ADVERTISED_HOST=192.168.1.10
