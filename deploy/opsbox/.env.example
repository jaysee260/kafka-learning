# Copy to .env (which is gitignored) and edit.

# The address other machines use to reach this host: its LAN IP, or a
# hostname that every client can resolve. The broker hands this address to
# every client that connects on port 19092, so it must be reachable from
# wherever your producers and consumers run. Give the host a static IP or a
# DHCP reservation, or clients break when the address changes.
REDPANDA_ADVERTISED_HOST=192.168.1.10

# MQTT passwords, one per client of the Mosquitto broker. Make each one up,
# for example with:  openssl rand -hex 16
# What each account may do is in mosquitto/acl.

# ring-mqtt: the only account that can write under ring/#
MQTT_RING_PASSWORD=change-me
# the Redpanda Connect bridge: read-only
MQTT_BRIDGE_PASSWORD=change-me
# you, with an MQTT client: read-only
MQTT_VIEWER_PASSWORD=change-me

# The public or LAN address of ntfy, if it sits behind a reverse proxy,
# for example https://ntfy.example.com. Leave empty to use port 2586 as is.
NTFY_BASE_URL=

# ntfy passwords, one per account. What each account may do is in
# ntfy/create-users.sh.

# hub-publisher: whatever sends alerts; can publish to home-* topics only
NTFY_PUBLISHER_PASSWORD=change-me
# phone: you, in the ntfy app or the web page; can read home-* topics only.
# You type this one on a phone, so pick something typeable.
NTFY_PHONE_PASSWORD=change-me

# Mining alerts: where the solo pool (ckpool) runs, and the SSH key that
# may log in there. The login needs passwordless sudo, because ckpool's
# stats folder is root-only. The known_hosts file must already contain
# that machine (ssh to it once by hand). Leave these empty if you don't
# mine, and don't start mining-watch.
CKPOOL_SSH=admin@192.168.1.20
CKPOOL_SSH_KEY=/home/you/.ssh/id_ed25519
CKPOOL_KNOWN_HOSTS=/home/you/.ssh/known_hosts
# The address your pool's blocks pay ("btcaddress" in ckpool.conf). A new
# block counts as yours when its reward goes here.
POOL_ADDRESS=bc1q...
